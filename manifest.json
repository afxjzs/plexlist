{
  "manifest_version": 3,
  "name": "PlexList",
  "version": "1.0.0",
  "description": "Turn an IMDb or Letterboxd list into a playlist on your own Plex server, in list order.",

  "permissions": ["storage"],

  "host_permissions": [
    "https://plex.tv/*",
    "https://*.plex.direct/*"
  ],

  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },

  "content_scripts": [
    {
      "matches": [
        "https://www.imdb.com/*",
        "https://letterboxd.com/*"
      ],
      "js": ["src/extract.js", "src/content.js"],
      "run_at": "document_idle"
    }
  ],

  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },

  "action": {
    "default_title": "PlexList — open the panel on an IMDb or Letterboxd list",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  }
}
